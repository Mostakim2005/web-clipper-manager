{
  "manifest_version": 3,
  "name": "Web Clipper Manager",
  "version": "1.0.0",
  "description": "Clip Facebook, Twitter/X, Reddit and articles into one Obsidian-ready Markdown format. PNG and PDF included.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "debugger",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_title": "Web Clipper Manager",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "src/pages/options.html",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "side_panel": {
    "default_path": "src/pages/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open Web Clipper Manager popup"
    },
    "quick-clip": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Silently clip and save active page to vault"
    }
  }
}
